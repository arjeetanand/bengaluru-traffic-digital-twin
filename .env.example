# TomTom API Key (Free tier available at developer.tomtom.com)
VITE_TOMTOM_KEY=your_tomtom_api_key_here

# Optional: enable the atlas place preview (Maps Embed API), on-demand live reviews
# (Maps JavaScript API + Places UI Kit), and simulator Google 3D mode (Map Tiles API).
VITE_GOOGLE_MAPS_KEY=your_browser_restricted_google_maps_key_here
